{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "api",
    "web",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "client": "concurrently -n api,web -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=client\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "seed": "npm run seed --workspace=api",
    "dev:client": "npm run dev --workspace=client",
    "lint": "npm run lint --workspace=client",
    "format": "npm run format --workspace=client",
    "format:check": "npm run format:check --workspace=client",
    "test": "npm run test --workspace=client",
    "build": "npm run build --workspace=client",
    "typecheck": "npm run typecheck:api && npm run typecheck:client",
    "typecheck:api": "npm run typecheck --workspace=api",
    "typecheck:client": "npm run typecheck --workspace=client",
    "codegen": "npm run codegen --workspace=client",
    "test:api": "npm run test --workspace=api",
    "migrate:logs": "npm run migrate:logs --workspace=api"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
