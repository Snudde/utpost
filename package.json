{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "api",
    "client",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n api,client -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=client\"",
    "client": "concurrently -n api,client -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=client\"",
    "dev:api": "npm run dev --workspace=api",
    "seed": "npm run seed --workspace=api",
    "dev:client": "npm run dev --workspace=client",
    "dev:host": "concurrently -n api,client -c blue,green \"npm run dev --workspace=api\" \"npm run dev:host --workspace=client\"",
    "dev:functions": "npm --prefix functions start",
    "mat": "node scripts/mat-upload.mjs",
    "cms:setup": "node --env-file-if-exists=.env scripts/cms-setup.mjs",
    "lint": "npm run lint --workspace=client",
    "cms:migrate-guides": "node --env-file-if-exists=.env scripts/migrate-guides.mjs",
    "cms:rensa-guider": "node --env-file-if-exists=.env scripts/cms-rensa-guider.mjs",
    "format": "npm run format --workspace=client",
    "format:check": "npm run format:check --workspace=client",
    "test": "npm run test --workspace=client",
    "build": "npm run build --workspace=client",
    "typecheck": "npm run typecheck:api && npm run typecheck:client",
    "typecheck:api": "npm run typecheck --workspace=api",
    "typecheck:client": "npm run typecheck --workspace=client",
    "codegen": "npm run codegen --workspace=client",
    "test:api": "npm run test --workspace=api",
    "migrate:logs": "npm run migrate:logs --workspace=api"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}