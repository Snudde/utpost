# Databaser
DATABASE_URL=postgres://utpost:utpost@localhost:5433/utpost
MONGO_URL=mongodb://utpost:utpost@localhost:27017/utpost?authSource=admin

# API & Autentisering
PORT=4000
JWT_SECRET=dev-secret-only-for-local-testing

# Startbeteende (1 i Azure Container Apps staging för att seeda tom databas)
SEED_ON_START=0

# Klient & Nginx (api:4000 i Docker Compose, localhost:4000 i Azure Container Apps)
API_UPSTREAM=api:4000

# Git Commit SHA (bakas in vid Docker-bygge i pipelinen)
GIT_SHA=dev

